# ============================================================
#  Weekly Operations Report  —  Config
#  Never commit passwords or webhook URLs to source control.
# ============================================================

# ------ PGT1 SQL Server (covers PGT 1.1 / PGT 1.4 lines) ------
SQL_SERVER_PGT1=PGT1MESSQLODS
SQL_DATABASE_PGT1=ODS
SQL_USERNAME_PGT1=
SQL_PASSWORD_PGT1=
SQL_DRIVER_PGT1=ODBC Driver 17 for SQL Server

# ------ PGT2 SQL Server (covers the PGT2 line) ------
# Leave SQL_SERVER_PGT2 blank if PGT2 isn't on this SQL Server (or
# isn't tracked here yet) — that line will show "not configured"
# instead of failing the whole report.
SQL_SERVER_PGT2=PGT2MESSQLODS
SQL_DATABASE_PGT2=ODS
SQL_USERNAME_PGT2=
SQL_PASSWORD_PGT2=
SQL_DRIVER_PGT2=ODBC Driver 17 for SQL Server

# ------ Plants and daily FG goals -----------------------------
# One entry per plant: <equipment/unit_prefix>:<display_label>:<daily_fg_goal>:<server_key>
#   prefix     — GlobalUnit.DisplayName / GlobalEquipment.Name prefix, e.g. PGT11
#   server_key — PGT1 or PGT2 (selects the connection block above)
PLANTS=PGT11:PGT 1.1:4600:PGT1,PGT14:PGT 1.4:4800:PGT1,PGT2:PGT2:12000:PGT2
# Target line on the Throughput FG chart (modules per day, all plants).
# Blank = sum of the daily FG goals above; 0 = no line.
FG_DAILY_TARGET=
# Top of the FG per day chart's y axis. Blank lets PowerPoint pick it.
FG_CHART_MAX=23000

# ------ Shift day ------------------------------------------------
# Hour a crew shift day starts. Crew Performance covers the shift days
# before today's shift start, so a night shift lands on the date it started.
SHIFT_START_HOUR=6
# Hour a day starts for the throughput numbers (FG per day, Critical Area,
# constraint, tool loss). 0 = midnight to midnight.
THROUGHPUT_DAY_START_HOUR=0
# The report covers a full Monday-Sunday week. Blank = last week; a date
# (YYYY-MM-DD) reports the week that contains it, e.g. to rerun an old week.
REPORT_WEEK_ENDING=

# ------ Query files (relative to this config file) -------------
AREA_HOURLY_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\weekly_area_hourly_query.sql"
FG_DAILY_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\weekly_fg_daily_query.sql"
CREW_SCORECARD_FG_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\weekly_crew_scorecard_fg_query.sql"

# ------ Throughput Critical Area (one slide per plant) -----------
# <Area>=<STATION>[|<STATION>...], where STATION is the equipment name
# after the 7-character line prefix (PGT14A-LAMINATOR -> LAMINATOR).
# Units of the same station on a line run side by side and are added up.
# PGT2's FRAME_C1-C3 have no run-time rows, so Framing counts at
# FRAME_PAIRING (see monthly_crew_kpi_pgt2.sql). Override for one plant
# with AREA_STATIONS_<prefix>, e.g. AREA_STATIONS_PGT11=...
AREA_STATIONS=Bussing=BUSSING,Laminator=LAMINATOR,Jbox=JUNCTION_BOX,Framing=FRAME_PAIRING
# Each plant names its Jbox and frame stations differently. Separate
# several stations with | (they are added up, so list stations that run
# side by side, not ones in series).
AREA_STATIONS_PGT11=Bussing=BUSSING,Laminator=LAMINATOR,Jbox=JUNCTION_BOX,Framing=FRAME
AREA_STATIONS_PGT14=Bussing=BUSSING,Laminator=LAMINATOR,Jbox=JUNCTION_BOX_STAGE2,Framing=FRAME_PAIRING
AREA_STATIONS_PGT2=Bussing=BUSSING,Laminator=LAMINATOR,Jbox=JUNCTION_BOX,Framing=FRAME_PAIRING
# MA can be measured on different stations than throughput. PGT 1.1's
# frame MA is on the four frame cells; its throughput is on FRAME.
# PGT 1.4 and PGT2 measure frame MA at FRAME_ASSEMBLY; their throughput
# is on FRAME_PAIRING.
AREA_MA_STATIONS_PGT11=Framing=FRAME_C1|FRAME_C2|FRAME_C3|FRAME_C4
AREA_MA_STATIONS_PGT14=Framing=FRAME_ASSEMBLY
AREA_MA_STATIONS_PGT2=Framing=FRAME_ASSEMBLY

# Weekly throughput goal per area (modules), for Utilization %.
# Leave a value blank and the cell says "set goal in config.env".
AREA_WEEKLY_GOALS_PGT11=Bussing=43400,Laminator=43400,Jbox=35000,Framing=35000
AREA_WEEKLY_GOALS_PGT14=Bussing=36400,Laminator=36400,Jbox=35700,Framing=35700
AREA_WEEKLY_GOALS_PGT2=Bussing=91000,Laminator=91000,Jbox=94465,Framing=94465

# MA goal per area, for the red / yellow / green MA cells. Taken from the
# station targets in hourly_ma_query.sql.
AREA_MA_GOALS=Bussing=0.93,Laminator=0.97,Jbox=0.88,Framing=0.93
AREA_MA_GOALS_PGT14=Bussing=0.93,Laminator=0.97,Jbox=0.92,Framing=0.93

# Cells are green when they meet their goal, yellow when they miss by up to
# this fraction of the goal (0.05 = 5%), red when they miss by more.
GOAL_WARN_BAND=0.05

# ------ Crew Performance (one slide per plant) -------------------
CREWS=A,B,C,D
# Area whose throughput fills the crew "Frame Throughput" row.
CREW_THROUGHPUT_AREA=Framing
# Shift days the Crew Performance slides cover (the rest of the deck is 7).
# Set the Rework rerun workbook's date filter to the same window.
CREW_WINDOW_DAYS=14
# Frame throughput row: "total" over the crew window, or "per_shift".
CREW_THROUGHPUT_MODE=total
# Goal column. Throughput, Catchall and FG are counts; ReworkRerun and
# FrameScrap are fractions (0.008 = 0.80%).
CREW_GOALS_PGT11=Throughput=16100,ReworkRerun=0.010,FrameScrap=0.010,Catchall=0,FG=16100
CREW_GOALS_PGT14=Throughput=16800,ReworkRerun=0.008,FrameScrap=0.010,Catchall=0,FG=16800
CREW_GOALS_PGT2=Throughput=44100,ReworkRerun=0.010,FrameScrap=0.010,Catchall=0,FG=44100

# Frame scrap: each plant logs it in a different table, so each plant
# has its own 14-day crew query. The report sets its window.
FRAME_SCRAP_QUERY_FILE_PGT11="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\crew_frame_scrap_14d_pgt11.sql"
FRAME_SCRAP_QUERY_FILE_PGT14="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\crew_frame_scrap_14d_pgt14.sql"
FRAME_SCRAP_QUERY_FILE_PGT2="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\crew_frame_scrap_14d_pgt2.sql"

# Catchall: one query for every plant; the report sets its @Plant and window.
CATCHALL_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\crew_catchall_14d.sql"

# Rework rerun: Hipot reruns / modules tested, by crew. The tables are in
# MesReporting on the PGT1 server for every site, so the query runs there
# for all three plants (REWORK_RERUN_SERVER_<prefix>=PGT2 to change one).
REWORK_RERUN_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\crew_rework_rerun_14d.sql"
REWORK_RERUN_SERVER=PGT1

# Fallback, used only when REWORK_RERUN_QUERY_FILE is blank or its query
# fails: an Excel workbook connected to the Power BI semantic model
# (Data > Get Data > From Power Platform > From Power BI semantic model)
# with a table that has Plant, Crew and
# ReworkRerun columns, Plant matching the labels in PLANTS. The report
# refreshes it through Excel before reading it (REFRESH_WORKBOOK=true
# to skip). Leave blank and the row says "not configured".
REWORK_RERUN_WORKBOOK=
REWORK_RERUN_SHEET=
REFRESH_WORKBOOK=false

# ------ Tool Loss (under each plant's Critical Area table) ---------
# Only big hitters and constraint tools are reported, not every tool.
# The tool loss Excel log on SharePoint. Click "Sync" on its document
# library so it shows up under your OneDrive folder, then put that path
# here (.xlsx or .csv). Leave blank and the slides have no tool loss.
TOOL_LOSS_FILE=
# Sheet name; blank = the first sheet.
TOOL_LOSS_SHEET=
# Column names in the log, as they appear in its header row. Leave
# ModulesLost or Downtime blank if the log doesn't have it. Plant values
# can be the labels or prefixes from PLANTS (PGT 1.1 or PGT11). Area is
# optional: when the log has an area or station column, tools in the
# week's daily constraint process count as constraint tools automatically
# (Area values like Jbox, Laminator or JUNCTION_BOX all match).
TOOL_LOSS_COLUMNS=Date=Date,Plant=Plant,Tool=Tool,Area=,ModulesLost=Modules Lost,Downtime=Downtime
# Unit of the Downtime column, shown in headers (min or hr).
TOOL_LOSS_DOWNTIME_UNIT=min
# Big hitters: the tools with the most modules lost this week, per plant.
TOOL_LOSS_TOP_N=3
# Constraint tools, per plant, as named in the log's Tool column (any case),
# separated by |. Shown after the big hitters whenever they lost anything
# this week or last. TOOL_LOSS_CONSTRAINT_TOOLS (no plant) applies to all.
# With an Area column (above) and the daily constraint set up (below),
# these are added to the tools found from the constraint.
TOOL_LOSS_CONSTRAINT_TOOLS_PGT11=
TOOL_LOSS_CONSTRAINT_TOOLS_PGT14=
TOOL_LOSS_CONSTRAINT_TOOLS_PGT2=
# Week-over-week rise that puts a reported tool on the watch list
# (0.5 = up 50% or more).
TOOL_LOSS_WATCH_INCREASE=0.5
# Summary workbook for Copilot, overwritten every week. Save it in a
# OneDrive-synced SharePoint folder and point a Copilot agent at it.
# Blank = no workbook (the slide's speaker notes still have the facts).
TOOL_LOSS_SUMMARY_FILE=

# ------ Daily constraint (row under each Critical Area table) -------
# Each hour, the process with the lowest capacity: its tools' uptime hours
# x 3600 / CT. Each day shows the process that was the constraint for the
# most hours, and the line's capacity (each hour's constraint, added up).
# Parallel cells (FRAME_C1, FRAME_C2 ...) count as one process, and the
# areas in AREA_STATIONS / AREA_MA_STATIONS keep their names (Jbox, Framing).
# Leave blank and the slides have no constraint row.
CONSTRAINT_QUERY_FILE="C:\Users\FS143179\OneDrive - First Solar\Yogesh Gurung\OE\Weekly Report\weekly_constraint_query.sql"
# The tools to look at, per plant: Process=NAME|NAME,... where NAME is a
# station (LAMINATOR = every unit's laminator) or one piece of equipment
# (PGT14A-LAMINATOR). Names under one process are added up as its
# capacity, so list parallel tools together. Only these compete for
# constraint, which keeps test, rework and side stations from being picked.
# Blank = every process with a CT competes (grouped automatically).
CONSTRAINT_CANDIDATES_PGT11=Bussing=PGT11A-BUSSING|PGT11B-BUSSING,CG Hole Seal=PGT11A-COVERGLASS_HOLE_SEAL|PGT11C-COVERGLASS_HOLE_SEAL,Edge Seal=PGT11A-EDGE_SEAL|PGT11C-EDGE_SEAL,Interlayer=PGT11A-INTERLAYER_PAIRING|PGT11C-INTERLAYER_PAIRING,CG Pairing=PGT11A-COVER_GLASS_PAIRING|PGT11C-COVER_GLASS_PAIRING,CG Washer=PGT11A-COVER_GLASS_WASHER,LF Fold=PGT11A-LF_FOLD|PGT11C-LF_FOLD,Laminator=PGT11A-LAMINATOR|PGT11B-LAMINATOR|PGT11C-LAMINATOR|PGT11D-LAMINATOR|PGT11E-LAMINATOR|PGT11H-LAMINATOR,BSA=PGT11A-BSA|PGT11B-BSA|PGT11C-BSA|PGT11D-BSA|PGT11E-BSA|PGT11H-BSA,Sim Gantry=PGT11A-SIMULATOR_GANTRY|PGT11B-SIMULATOR_GANTRY,ARC Washer=PGT11A-ARC_WASHER,ARC Rollcoat=PGT11A-ARC_ROLLCOAT,ARC Cure=PGT11A-ARC_AIR_CURE|PGT11B-ARC_AIR_CURE,Jbox=PGT11A-JUNCTION_BOX|PGT11B-JUNCTION_BOX,Sim Hipot=PGT11A-SIM_HIPOT|PGT11B-SIM_HIPOT|PGT11C-SIM_HIPOT,EOL Washer=PGT11A-EOL_WASHER,Cable Pull=PGT11A-CABLE_PULL,Framing=PGT11A-FRAME_C1|PGT11A-FRAME_C2|PGT11A-FRAME_C3|PGT11A-FRAME_C4,Labeler=PGT11A-LABELER
CONSTRAINT_CANDIDATES_PGT14=Bussing=PGT14A-BUSSING|PGT14B-BUSSING,CG Hole Seal=PGT14A-COVERGLASS_HOLE_SEAL,Edge Seal=PGT14A-EDGE_SEAL_APPLY|PGT14B-EDGE_SEAL_APPLY,Interlayer=PGT14A-INTERLAYER_PAIRING|PGT14B-INTERLAYER_PAIRING,CG Pairing=PGT14A-COVER_GLASS_PAIRING,CG Washer=PGT14A-COVER_GLASS_WASHER,LF Fold=PGT14A-LF_FOLD,Laminator=PGT14A-LAMINATOR|PGT14B-LAMINATOR|PGT14C-LAMINATOR|PGT14D-LAMINATOR|PGT14E-LAMINATOR,BSA=PGT14A-BSA|PGT14B-BSA|PGT14C-BSA|PGT14D-BSA|PGT14E-BSA,Sim Gantry=PGT14A-SIMULATOR_GANTRY|PGT14B-SIMULATOR_GANTRY,ARC Washer=PGT14A-ARC_WASHER,ARC Rollcoat=PGT14A-ARC_ROLLCOAT,ARC Cure=PGT14A-ARC_AIR_CURE|PGT14B-ARC_AIR_CURE,Jbox Stage1=PGT14A-JUNCTION_BOX_STAGE1|PGT14B-JUNCTION_BOX_STAGE1,Jbox=PGT14A-JUNCTION_BOX_STAGE2|PGT14B-JUNCTION_BOX_STAGE2,Auto Tape=PGT14A-AUTO_TAPE,Framing=PGT14A-FRAME_PAIRING|PGT14B-FRAME_PAIRING,Labeler=PGT14A-LABELER
CONSTRAINT_CANDIDATES_PGT2=Bussing=PGT21A-BUSSING|PGT21B-BUSSING|PGT21C-BUSSING,CG Hole Seal=PGT21A-COVERGLASS_HOLE_SEAL|PGT21C-COVERGLASS_HOLE_SEAL|PGT22A-COVERGLASS_HOLE_SEAL,Edge Seal=PGT21A-EDGE_SEAL|PGT21B-EDGE_SEAL|PGT21C-EDGE_SEAL|PGT21D-EDGE_SEAL|PGT22A-EDGE_SEAL|PGT22B-EDGE_SEAL,Interlayer=PGT21A-INTERLAYER_PAIRING|PGT21B-INTERLAYER_PAIRING|PGT21C-INTERLAYER_PAIRING|PGT22A-INTERLAYER_PAIRING|PGT22B-INTERLAYER_PAIRING,CG Pairing=PGT21A-COVER_GLASS_PAIRING|PGT21C-COVER_GLASS_PAIRING|PGT22A-COVER_GLASS_PAIRING,CG Washer=PGT21A-COVER_GLASS_WASHER|PGT21C-COVER_GLASS_WASHER|PGT22A-COVER_GLASS_WASHER,LF Fold=PGT21A-LF_FOLD|PGT21B-LF_FOLD|PGT21C-LF_FOLD|PGT22A-LF_FOLD,Laminator=PGT21A-LAMINATOR|PGT21B-LAMINATOR|PGT21C-LAMINATOR|PGT21D-LAMINATOR|PGT21E-LAMINATOR|PGT21F-LAMINATOR|PGT21G-LAMINATOR|PGT22A-LAMINATOR|PGT22B-LAMINATOR|PGT22C-LAMINATOR|PGT22D-LAMINATOR|PGT22E-LAMINATOR,BSA=PGT21A-BSA|PGT21B-BSA|PGT21C-BSA|PGT21D-BSA|PGT21E-BSA|PGT21F-BSA|PGT21G-BSA|PGT22A-BSA|PGT22B-BSA|PGT22C-BSA|PGT22D-BSA|PGT22E-BSA,Sim Gantry=PGT21A-SIMULATOR_GANTRY|PGT21B-SIMULATOR_GANTRY|PGT21C-SIMULATOR_GANTRY|PGT22A-SIMULATOR_GANTRY|PGT22B-SIMULATOR_GANTRY,ARC Washer=PGT21A-ARC_WASHER|PGT21B-ARC_WASHER|PGT22A-ARC_WASHER,ARC Rollcoat=PGT21A-ARC_ROLLCOAT|PGT21B-ARC_ROLLCOAT|PGT22A-ARC_ROLLCOAT,ARC Cure=PGT21A-ARC_AIR_CURE|PGT21B-ARC_AIR_CURE|PGT22A-ARC_AIR_CURE|PGT22B-ARC_AIR_CURE,Jbox=PGT21A-JUNCTION_BOX|PGT21B-JUNCTION_BOX|PGT21C-JUNCTION_BOX|PGT21D-JUNCTION_BOX|PGT22A-JUNCTION_BOX|PGT22B-JUNCTION_BOX,Sim Hipot=PGT21A-SIM_HIPOT|PGT21B-SIM_HIPOT|PGT21C-SIM_HIPOT|PGT21D-SIM_HIPOT|PGT22A-SIM_HIPOT|PGT22B-SIM_HIPOT,EOL Washer=PGT21A-EOL_WASHER|PGT21B-EOL_WASHER|PGT22A-EOL_WASHER,Cable Pull=PGT21A-CABLE_PULL|PGT21B-CABLE_PULL|PGT22A-CABLE_PULL,Framing=PGT21A-FRAME_PAIRING|PGT21B-FRAME_PAIRING|PGT21C-FRAME_PAIRING|PGT22A-FRAME_PAIRING|PGT22B-FRAME_PAIRING|PGT22C-FRAME_PAIRING
# Stations left out when there is no list above (name contains any of these, separated by |).
CONSTRAINT_EXCLUDE=REWORK|CVS|NPR|LED|SCRIBE
# A process blocked or starved for more than this share of its uptime was
# waiting on another one, so it can't be the constraint even with the
# lowest capacity. If every process was, the lowest is shown with "?".
CONSTRAINT_IDLE_MAX=0.15
# CT for capacity: "actual" = each tool's median time between parts that
# hour (same rule as weekly_ct_query.sql), or "target" = CycleTimeInSeconds.
# With actual, an hour falls back to the target when the tool made fewer
# than CONSTRAINT_MIN_CYCLES cycles, or its actual CT was outside
# CONSTRAINT_ACTUAL_CT_RANGE x the target (a glitch, not a real rate).
CONSTRAINT_CT_SOURCE=actual
CONSTRAINT_MIN_CYCLES=5
CONSTRAINT_ACTUAL_CT_RANGE=0.5,3
# Modules per CT target for stations whose CT target isn't one module, by
# station name (actual CT is already per module, so it isn't applied to it).
# The E10 query's MU counts LAM and BSA at 3600 / (4 x CT), which would be
# CONSTRAINT_RATE_FACTOR=LAMINATOR=0.25,BSA=0.25 here. Leave it blank until
# the first run: the run log warns when a process makes more than its
# capacity at CT (factor too low) or under 40% of it all week (too high).
# Per plant: CONSTRAINT_RATE_FACTOR_PGT11=...
CONSTRAINT_RATE_FACTOR=

# ------ Area loss (speaker notes + summary workbook) ----------------
# Each day, every constraint candidate process's good modules vs its daily
# goal. When short by more than AREA_LOSS_THRESHOLD of the goal (0.02 =
# 2%), the shortfall is split per tool into downtime, CT (running slower
# than target), waiting (blocked / starved: another area's loss) and
# quality, in modules at the CT target. Uses the constraint query's data.
AREA_LOSS_THRESHOLD=0.02
# Tool losses listed per short process-day in the notes.
AREA_LOSS_TOP_N=3
# Daily goal per process, e.g. AREA_LOSS_DAILY_GOALS_PGT11=Laminator=4800.
# Blank = the plant's daily FG goal in PLANTS.
AREA_LOSS_DAILY_GOALS_PGT11=
AREA_LOSS_DAILY_GOALS_PGT14=
AREA_LOSS_DAILY_GOALS_PGT2=

# ------ PowerPoint output -----------------------------------------
# The team's deck template. Its slides are the outline: the report fills
# the Throughput, Critical Area and Crew slides and leaves the rest (Power
# BI add-in slides, safety table, ROC, HC) as they are.
PPTX_TEMPLATE=Template.pptx
# Folder for the dated output file (Weekly_Ops_Report_YYYY-MM-DD.pptx).
# Leave blank to save alongside this script.
PPTX_OUTPUT_DIR=
